[ext_resource type="PackedScene" path="res://scenes/grid/GridManager.tscn" id="5_grid"]
[ext_resource type="PackedScene" path="res://scenes/ui/GameOverScreen.tscn" id="6_over"]
[ext_resource type="Resource" path="res://data/player_base_stats.tres" id="7_player"]
[ext_resource type="PackedScene" path="res://scenes/ui/MessageLog.tscn" id="8_log"]
